# --- AUTOSTART ANCILLARY PROGRAMS ---
# Core desktop layout and rendering (runs on every config reload)
exec_always --no-startup-id feh --bg-fill ~/Downloads/wallpaper/bbm.jpg  
exec_always --no-startup-id picom -b

# Lock automatically on sleep / suspend events
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock \
  --inside-color=1e1e2e00 \
  --ring-color=89b4fa \
  --keyhl-color=f38ba8 \
  --line-uses-ring \
  --separator-color=00000000 \
  --verif-text='Verifying...' \
  --wrong-text='Wrong!' \
  --clock --indicator --nofork

# --- CONFIGURATION VARIABLES ---
set $mod Mod4

# Use clean 2px borders with no titlebars
default_border pixel 2
default_floating_border pixel 2

# --- WORKSPACE ASSIGNMENTS ---
# Force settings apps to always open on workspace 9
assign [class="Pavucontrol"] 9
assign [class="Blueman-manager"] 9
assign [class="Arandr"] 9

# --- KEYBINDINGS ---
# Application Launchers
bindsym $mod+Return exec ghostty
bindsym $mod+Shift+w exec com.brave.Browser
bindsym $mod+d exec dmenu_run

# Navigate Workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Shift current workspace 
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Toggle fullscreen mode using the Up arrow key
bindsym $mod+f fullscreen toggle

# Shift focused tiled window using Arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Core System Commands
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "printf 'No\\nYes\\n' | dmenu -i -p 'Are you sure you want to exit i3?' | grep -q '^Yes$' && i3-msg exit"

# Vim Window focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Vim Shift focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Horizontal and Vertical split
bindsym $mod+b split h
bindsym $mod+v split v

# Trigger a manual sleep event (xss-lock will catch this and lock first)
bindsym $mod+Shift+s exec systemctl suspend

# --- THE STATUS BAR ---
bar {
        position bottom
        status_command i3status
        
        colors {
                background #1e1e2e
                statusline #ffffff
                separator  #6c7086

                #                  border  bg      text
                focused_workspace  #89b4fa #89b4fa #11111b
                active_workspace   #313244 #313244 #cdd6f4
                inactive_workspace #1e1e2e #1e1e2e #a6adc8
                urgent_workspace   #f38ba8 #f38ba8 #11111b
        }
}

